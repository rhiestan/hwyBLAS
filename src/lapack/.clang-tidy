# clang-tidy checks for the LAPACK routines: those of hwyBLAS (../../.clang-tidy)
# except:
#  - readability-suspicious-call-argument: LAPACK passes its matrices to the
#    BLAS and to other routines in roles with other names (e.g. its C, LDC
#    as A, LDA of xGEMM), which this check reports as swapped arguments.
#  - misc-confusable-identifiers: the ports keep LAPACK's names, which
#    include pairs such as K1 and KL.
#  - readability-else-after-return: the ports keep LAPACK's control flow
#    (IF ... RETURN ... ELSE), line by line.
InheritParentConfig: true
Checks: >
  -readability-suspicious-call-argument,
  -misc-confusable-identifiers,
  -readability-else-after-return
